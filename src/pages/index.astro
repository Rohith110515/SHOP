---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';

const featuredIds = ['1', '3', '5', '7'];
const featured = products.filter((product) => featuredIds.includes(product.id));
---

<Layout title="MyShop — Shop smarter">
	<section class="hero">
		<h1>Everyday essentials, chosen with care.</h1>
		<p>A clean storefront for electronics, fashion, and accessories — built as a frontend prototype with a local cart.</p>
		<a class="btn btn-light" href="/products">Shop now</a>
	</section>

	<h2 class="section-title">Shop by category</h2>
	<div class="category-grid">
		<a class="category-card" href="/products?category=Electronics">
			<strong>Electronics</strong>
			<span>Headphones, watches, and more</span>
		</a>
		<a class="category-card" href="/products?category=Fashion">
			<strong>Fashion</strong>
			<span>Tees, jackets, and daily wear</span>
		</a>
		<a class="category-card" href="/products?category=Accessories">
			<strong>Accessories</strong>
			<span>Wallets, sunglasses, and extras</span>
		</a>
	</div>

	<h2 class="section-title">Featured products</h2>
	<div class="product-grid">
		{featured.map((product) => <ProductCard product={product} />)}
	</div>

	<div class="perks">
		<div class="perk">
			<strong>Free shipping over ₹999</strong>
			<p class="muted">Fast dispatch on every order in this demo.</p>
		</div>
		<div class="perk">
			<strong>Easy returns</strong>
			<p class="muted">Change your mind? Returns are simple and friendly.</p>
		</div>
		<div class="perk">
			<strong>Secure shopping</strong>
			<p class="muted">A protected frontend experience you can browse with confidence.</p>
		</div>
	</div>
</Layout>
